# Copy this file to .env.local for development. Never commit .env.local or .env.prod.
#
# Development: a plain file on your computer. No account needed.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
#
# Live site (put these in a file called .env.prod, and in Netlify's environment variables):
# TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
# TURSO_AUTH_TOKEN=paste-the-token-from-the-turso-dashboard
